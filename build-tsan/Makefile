# target to preprocess a source file
tests/test_zmq_sink.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/rich_on_tests.dir/build.make CMakeFiles/rich_on_tests.dir/tests/test_zmq_sink.cpp.i
.PHONY : tests/test_zmq_sink.cpp.i

tests/test_zmq_sink.s: tests/test_zmq_sink.cpp.s
.PHONY : tests/test_zmq_sink.s

# target to generate assembly for a file
tests/test_zmq_sink.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/rich_on_tests.dir/build.make CMakeFiles/rich_on_tests.dir/tests/test_zmq_sink.cpp.s
.PHONY : tests/test_zmq_sink.cpp.s

